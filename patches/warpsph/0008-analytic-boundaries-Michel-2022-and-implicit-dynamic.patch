+    x64, m64, c64 = x.to(F64), m.to(F64), centers.to(F64)
+    out = []
+    for acc in (accP, accV):
+        F = -m64[None, :, None] * acc.to(F64)
+        r = x64[None] - c64[:, None, :]
+        tau = (r[..., 0] * F[..., 1] - r[..., 1] * F[..., 0]).sum(1)
+        out.append(torch.cat([F.sum(1), tau[:, None]], 1))
+    return torch.stack(out)

@@ -68,3 +68,24 @@ def test_mixed_scene_analytic_tank_with_a_particle_obstacle_runs():
     assert abs(mixed['ke'] / ref['ke'] - 1.0) < 0.08, (mixed['ke'], ref['ke'])
     assert mixed['rmin'] > 0.95 and mixed['rmax'] < 1.06
